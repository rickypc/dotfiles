{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on"
      }
    }
  },
  "files": { "ignoreUnknown": true },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "delimiterSpacing": false,
      "lineEnding": "lf",
      "lineWidth": 100,
      "operatorLinebreak": "before",
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 10 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noExcessiveNestedCallbacks": "error",
        "noUselessSwitchCase": "error",
        "useMaxParams": { "level": "error", "options": { "max": 10 } }
      },
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "useSingleJsDocAsterisk": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "preset": "recommended",
      "security": { "noSecrets": "error" },
      "style": {
        "noExcessiveClassesPerFile": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 1000, "skipBlankLines": true }
        },
        "useBlockStatements": "error",
        "useDefaultSwitchClause": "error",
        "useImportsFirst": "error",
        "useThisInClassMethods": "error",
        "useVarsOnTop": "error"
      },
      "suspicious": {
        "noConditionalExpect": "error",
        "noIdenticalTestTitle": "error",
        "noLoopFunc": "error",
        "useExpect": "error"
      }
    }
  },
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true }
}
